# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Special characters in the password must be percent-encoded (e.g. @ -> %40).
DATABASE_URL=postgres://postgres:112233@localhost:5432/management

# PostgreSQL schema that Django creates its tables in (default: checklist)
DB_SCHEMA=checklist

# Signs access tokens. Optional in development (an insecure default is used); required in production.
# SECRET_KEY=change-me-to-a-long-random-string

# Where the frontend runs. Emailed links (verify email, reset password) point here (default: http://localhost:3000)
# FRONTEND_URL=http://localhost:3000

# Browser origins allowed to call the API, comma-separated (default: FRONTEND_URL)
# CORS_ALLOWED_ORIGINS=http://localhost:3000
